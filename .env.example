# ==============================================================================
# CONTRU ESTOQUE - CONFIGURAÇÃO DE AMBIENTE (SUPABASE / POSTGRESQL / WEB)
# ==============================================================================

# Para conectar ao Supabase (PostgreSQL em Nuvem):
# 1. Crie uma conta gratuita em https://supabase.com
# 2. Crie um novo projeto (ex: contru-estoque)
# 3. Acesse: Project Settings -> Database -> Connection string (URI)
# 4. Copie e cole aqui com sua senha e sslmode:
# Exemplo:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Deixe vazio para usar banco local SQLite durante testes locais
DATABASE_URL=

PORT=5000
FLASK_ENV=development
SECRET_KEY=contru-estoque-secret-key-2026-secure
